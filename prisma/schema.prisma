generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  // Client Side
  CLIENT_MANAGER
  SITE_ADMIN
  SITE_MANAGER
  TECHNICIAN
  DOCTOR

  // MedMarvel Side
  MASTER_ADMIN
  CLIENT_ADMIN
  OPERATIONS_HEAD
  OPERATIONS_MANAGER
  OPERATOR
}

enum StudyStatus {
  UPLOADED
  PROCESSING
  READY
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  sites Site[]
  users User[]
}

model Site {
  id            String   @id @default(cuid())
  name          String
  institutionId String
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])

  users   User[]
  studies Study[]
}

model User {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  role UserRole

  institutionId String
  siteId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])

  site Site? @relation(fields: [siteId], references: [id])

  // Technician uploads
  uploadedStudies Study[] @relation("TechnicianStudies")

  // Doctor assigned studies
  doctorStudies Study[] @relation("DoctorStudies")

  // Operator assigned studies
  operatorStudies Study[] @relation("OperatorStudies")

  comments StudyComment[]
}

model Patient {
  id String @id @default(cuid())

  patientId   String
  patientName String

  age    Int?
  gender String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studies Study[]
}

model Study {
  id String @id @default(cuid())

  studyDescription String?
  modality         String?

  status StudyStatus @default(UPLOADED)

  patientId String?
  siteId    String

  technicianId String?
  doctorId     String?
  operatorId   String?

  imagingLink String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient? @relation(fields: [patientId], references: [id])

  site Site @relation(fields: [siteId], references: [id])

  technician User? @relation("TechnicianStudies", fields: [technicianId], references: [id])

  doctor User? @relation("DoctorStudies", fields: [doctorId], references: [id])

  operator User? @relation("OperatorStudies", fields: [operatorId], references: [id])

  files StudyFile[]

  report Report?

  comments StudyComment[]
}

model StudyFile {
  id String @id @default(cuid())

  studyId String

  fileName String
  fileUrl  String
  fileType String

  // Supports folder uploads
  folderPath String?

  createdAt DateTime @default(now())

  study Study @relation(fields: [studyId], references: [id])
}

model Report {
  id String @id @default(cuid())

  studyId String @unique

  reportUrl String

  uploadedAt DateTime @default(now())

  study Study @relation(fields: [studyId], references: [id])
}

model StudyComment {
  id String @id @default(cuid())

  studyId String
  userId  String

  message String

  createdAt DateTime @default(now())

  study Study @relation(fields: [studyId], references: [id])

  user User @relation(fields: [userId], references: [id])
}
